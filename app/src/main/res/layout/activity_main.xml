<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TARJETA DE MÉTRICAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MÉTRICAS EN TIEMPO REAL"
                android:textColor="#00FF66"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dispositivo: Causalizandose..."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvPeticiones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peticiones Totales: 0 (UDP: 0 | POST/Ping: 0)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvConsumo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consumo: 0 MB (0.00 GB)"
                android:textColor="#00E5FF"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- SELECCIÓN DE INTENSIDAD -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intensidad de Saturación:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgIntensidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbNormal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Normal"
                android:textColor="#FFFFFF"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbDoble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Doble (x2)"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbFull"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="Full Burst"
                android:textColor="#FF5252"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- INDICADOR DE ENVÍO AUTOMÁTICO A SHEETS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#252525"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <CheckBox
                android:id="@+id/chkAutoSheets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:enabled="false"
                android:buttonTint="#00FF66" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvEstadoSheets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sincronización a Google Sheets: ACTIVA"
                    android:textColor="#00FF66"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reporte automático generado cada 60 segundos"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BOTONES DE CONTROL -->
        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="INICIAR PRUEBAS"
            android:backgroundTint="#00C853"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnDetener"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="DETENER PRUEBAS"
            android:backgroundTint="#D50000"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- CONSOLA DE LOGS EN VIVO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consola de Procesos en Vivo:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <ScrollView
            android:id="@+id/scrollConsole"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#000000"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvLogConsole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#00FF00"
                android:textSize="11sp"
                android:text="[ESPERA] Presiona INICIAR PRUEBAS para comenzar...\n" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
