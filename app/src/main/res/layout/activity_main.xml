<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NetworkTester Pro"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp" />

        <!-- Tarjeta de Métricas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MÉTRICAS EN TIEMPO REAL"
                android:textColor="#00E676"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dispositivo: Cargando..."
                android:textColor="#B0BEC5"
                android:textSize="12sp"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/tvPeticiones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Peticiones Totales: 0 (UDP: 0 | POST/Ping: 0)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/tvConsumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Consumo: 0.00 MB (0.000 GB)"
                android:textColor="#00B0FF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Intensidad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Intensidad de Saturación:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <RadioGroup
            android:id="@+id/rgIntensidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <RadioButton
                android:id="@+id/rbNormal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Normal"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbDoble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Doble (x2)"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbBurst"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Full Burst (+1GB/m)"
                android:textColor="#FF5252"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Programación de Reporte -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programar Hora de Envio Automático a Google Sheets:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <EditText
            android:id="@+id/etHoraReporte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2C2C2C"
            android:hint="HH:mm (ejemplo 23:55)"
            android:textColorHint="#757575"
            android:textColor="#00E676"
            android:inputType="time"
            android:padding="12dp"
            android:layout_marginTop="6dp" />

        <!-- Botones de Acción -->
        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INICIAR PRUEBAS Y PROGRAMAR"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnEnviarAhora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 ENVIAR AHORA A GOOGLE SHEETS"
            android:backgroundTint="#0288D1"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnDetener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETENER PRUEBAS"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Consola de Salida -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consola de Procesos en Vivo:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <TextView
            android:id="@+id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#000000"
            android:padding="10dp"
            android:text="Esperando inicio de pruebas..."
            android:textColor="#00FF00"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:scrollbars="vertical"
            android:layout_marginTop="6dp" />

    </LinearLayout>
</ScrollView>
